# Heal configuration. Copy to .env and adjust; every variable is optional and
# falls back to the default shown here.

# Application
HEAL_API_HOST=0.0.0.0
HEAL_API_PORT=8000
HEAL_API_LOG_LEVEL=INFO
HEAL_API_DEBUG=false
HEAL_API_ENVIRONMENT=development

# Structured JSON logs; set false for human-readable lines in development
HEAL_API_LOG_JSON=true

# Error reporting; leave the DSN empty to keep Sentry disabled
HEAL_API_SENTRY_DSN=
HEAL_API_SENTRY_TRACES_SAMPLE_RATE=0.0

# API documentation (disable the browser UIs in production if desired;
# /openapi.json stays available either way)
HEAL_API_DOCS_ENABLED=true
HEAL_API_REDOC_ENABLED=true

# Origins allowed to call the API from a browser, comma-separated.
# The dashboard needs its own origin listed here.
HEAL_API_CORS_ORIGINS=http://localhost:3000

# MySQL - stores target configuration and latest status
# Values below match docker-compose.infra.yml
HEAL_API_DATABASE_HOST=localhost
HEAL_API_DATABASE_PORT=3306
HEAL_API_DATABASE_NAME=heal
HEAL_API_DATABASE_USER=heal
HEAL_API_DATABASE_PASSWORD=heal

# InfluxDB - stores historical latency and availability metrics
HEAL_API_INFLUXDB_URL=http://localhost:8086
HEAL_API_INFLUXDB_TOKEN=heal-dev-token
HEAL_API_INFLUXDB_ORG=heal
HEAL_API_INFLUXDB_BUCKET=heal

# Monitoring defaults, overridable per target
HEAL_API_CHECK_INTERVAL=30
HEAL_API_CHECK_TIMEOUT=5
HEAL_API_CHECK_RETRIES=2
HEAL_API_WORKER_CONCURRENCY=20

# Identifies the replica holding a lease; defaults to HOSTNAME (the pod name)
# HEAL_API_WORKER_ID=

# Sites a worker claims per tick
HEAL_API_CLAIM_BATCH_SIZE=50

# Lease duration; must exceed the worst-case time to check one site
HEAL_API_LEASE_SECONDS=120

# Seconds to let in-flight checks finish on SIGTERM
HEAL_API_SHUTDOWN_TIMEOUT=30

# ICMP needs raw sockets, which containers often lack. Heal runs without it.
HEAL_API_ICMP_ENABLED=false

# Allow probing loopback, link-local, private, and metadata addresses.
# Keep false unless Heal monitors internal infrastructure.
HEAL_API_ALLOW_PRIVATE_TARGETS=false
