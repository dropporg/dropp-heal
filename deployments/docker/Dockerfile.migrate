# Heal migrations: applies Alembic revisions. Runs as a Job before a rollout,
# never from the application pods, which would race on the schema.
# Build from the repository root:
#   docker build -f deployments/docker/Dockerfile.migrate -t heal-migrate .

FROM python:3.13-slim AS builder

WORKDIR /build
COPY requirements.txt .
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt


FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 heal

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
# migrations/env.py imports the models, so the api package comes along.
COPY --chown=heal:heal alembic.ini ./
COPY --chown=heal:heal api ./api
COPY --chown=heal:heal migrations ./migrations

USER heal

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["alembic", "upgrade", "head"]
