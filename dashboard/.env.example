# Where the dashboard server proxies /api requests. The browser only ever talks
# to the dashboard's own origin, so no CORS configuration is needed.
HEAL_API_URL=http://localhost:8000

# Optional: call the API directly from the browser instead of through the proxy.
# The API must then list this dashboard's origin in HEAL_API_CORS_ORIGINS.
# NEXT_PUBLIC_API_URL=http://localhost:8000
